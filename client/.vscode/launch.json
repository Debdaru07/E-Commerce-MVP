{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Debug)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=BASE_URL=http://localhost:8080",
        "--dart-define=ADMIN_LOGIN=/auth/admin/login",
        "--dart-define=DEALER_LOGIN=/auth/dealer/login",
        "--dart-define=CONSUMER_LOGIN=/auth/consumer/login"
      ]
    }
  ]
}
