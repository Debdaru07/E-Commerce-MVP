{
  "routes": [
    {
      "src": "/(.*\\.(js|css|wasm|json|png|jpg|jpeg|svg|ico|ttf|woff|woff2))",
      "dest": "/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "dest": "/canvaskit/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
